{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npx ng lint *)",
            "Bash(npx ng test *)",
            "Bash(npx ng build *)",
            "Bash(npx oxfmt *)",
            "Bash(npm run lint*)",
            "Bash(npm run format*)",
            "Bash(npm test*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)"
        ],
        "deny": ["Bash(git commit*)", "Bash(git push*)"]
    }
}
